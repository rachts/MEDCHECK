# =============================================================================
# MEDCHECK Environment Variables Template
#
# Copy to `.env` at the repository root. docker-compose loads this file into the
# backend container (see `env_file:` in docker-compose.yml).
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for docker-compose
# -----------------------------------------------------------------------------
# docker-compose runs the backend with ENV=production, and the application now
# refuses to start in production or staging without an explicit JWT signing key
# of at least 32 characters. No default ships in the source tree, because a
# secret committed to a repository is a published secret -- leave this blank here
# and fill it in only in your untracked `.env`.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# HMAC key used to pseudonymise client IPs in the audit log (Optional).
# Derived from JWT_SECRET when unset; set it explicitly to keep audit records
# correlatable across a JWT_SECRET rotation.
AUDIT_IP_SALT=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Mistral AI API Key for parsing FDA drug labels (Optional)
# If omitted, MEDCHECK operates on its built-in deterministic clinical rule engine.
MISTRAL_API_KEY=your_mistral_api_key_here

# Supabase Configuration (Optional - falls back to local SQLite cache if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Redis connection for distributed rate limiting (Optional).
# REDIS_URL=redis://localhost:6379

# Redirect plaintext HTTP to HTTPS inside the app. Leave false when a reverse
# proxy or load balancer terminates TLS, or requests will redirect in a loop.
FORCE_HTTPS=false

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Allowed CORS Origins (comma-separated exact URLs; no trailing slashes)
# IMPORTANT: allow_credentials=True forbids wildcard '*' in production/staging.
# List your exact frontend domain(s), e.g. https://your-medcheck.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend API URL (for Vite). Inlined into the JavaScript bundle at build time,
# so it must never hold a secret.
VITE_API_URL=http://localhost:8000
