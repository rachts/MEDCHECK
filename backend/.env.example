# =============================================================================
# MedCheck Backend Environment Variables Template
# =============================================================================

# -----------------------------------------------------------------------------
# Security (REQUIRED when ENV=staging or ENV=production)
# -----------------------------------------------------------------------------
# JWT signing key. No default ships in the source tree, because a secret
# committed to a repository is a published secret. In development the app
# generates an ephemeral key per process (tokens die on restart); staging and
# production refuse to start without a real value of at least 32 characters.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# HMAC key that pseudonymises client IPs in the audit log. Optional: when unset
# it is derived from JWT_SECRET. Set it explicitly if you need audit records to
# stay correlatable across a JWT_SECRET rotation.
AUDIT_IP_SALT=

# Redirect plaintext HTTP to HTTPS inside the application. Enable ONLY when this
# process terminates TLS itself. Behind a TLS-terminating reverse proxy (nginx,
# a load balancer, Fly/Render/Railway) this causes a redirect loop -- leave it
# false and let the proxy handle the redirect.
FORCE_HTTPS=false

# Lifetime of an anonymous guest session, in minutes. Guest tokens are bearer
# credentials that nobody can revoke, so they are deliberately much shorter-lived
# than the 7-day token issued to a registered account.
GUEST_TOKEN_EXPIRE_MINUTES=120

# -----------------------------------------------------------------------------
# External services
# -----------------------------------------------------------------------------
# Mistral AI API Key for parsing unstructured FDA drug labels (Optional)
# If omitted, MedCheck uses built-in deterministic clinical rule matching.
MISTRAL_API_KEY=your_mistral_api_key_here

# Supabase Configuration (Optional - falls back to local SQLite cache if omitted)
# The interaction_pairs and drug_details tables should each carry an
# `expires_at timestamptz` column so remote cache rows can expire; without it,
# TTL is enforced on read from `created_at` instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Redis connection for distributed rate limiting (Optional).
# Without it, rate-limit counters live in process memory and are therefore
# per-worker -- fine for a single container, ineffective behind a load balancer.
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENV=development

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
