# MedCheck Frontend Build Configuration

# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Public origin this frontend is served from, WITHOUT a trailing slash.
#
# Substituted at build time into index.html's canonical / og:url / twitter:image
# tags, the Sitemap line in public/robots.txt, and every <loc> in
# public/sitemap.xml. A production build that leaves this unset falls back to
# http://localhost:5173 and prints a warning -- deploying that would tell search
# engines your canonical URL is localhost.
#
# Example: VITE_SITE_URL=https://medcheck.example.org
VITE_SITE_URL=http://localhost:5173
