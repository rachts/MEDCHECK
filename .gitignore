# ==============================================================================
# MEDCHECK — Comprehensive .gitignore
# ==============================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.production
.env.development
.env.docker
!.env.example
secrets/
*.pem
*.key
.envrc

# SQLite WAL & Journal Files (Critical — generated by WAL mode)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal
backend/local_cache.db
local_cache.db

# Python Bytecode & Packaging Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
__pypackages__/

# Python Linting & Type Checking Caches
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Python Environment Managers
.venv/
venv/
ENV/
env/
venv*/
.python-version
Pipfile.lock
poetry.lock

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/

# Frontend Dependencies & Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
frontend/.turbo/
frontend/storybook-static/
frontend/playwright-report/
frontend/test-results/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker Local Overrides
docker-compose.override.yml

# IDE, OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs & Audit Trails
*.log
logs/
backend/audit_logs/
*.audit.log

# Temporary Files & Scratchpads
tmp/
temp/
*.tmp
*.bak

# Documentation & AI Scratch Folders
prompts/
*.prompt
ai-generated/
docs/

# Binary & Document Blobs
*.zip
*.tar.gz
*.pdf
*.docx