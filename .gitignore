# ==============================================================================
# MEDCHECK — Comprehensive .gitignore
# ==============================================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
secrets/
*.pem
*.key

# Python Bytecode & Packaging Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
venv*/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.tox/
.nox/

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Databases & Local Caches
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/local_cache.db
local_cache.db

# IDE, OS & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Logs
*.log
logs/

# Temporary Files & Scratchpads
tmp/
temp/
*.tmp
*.bak

# AI Prompts & Internal Scratch Folders
prompts/
*.prompt
ai-generated/
docs/

# Binary & Document Blobs
*.zip
*.tar.gz
*.pdf
*.docx