{
  "name": "medcheck-root",
  "private": true,
  "version": "2.0.0",
  "description": "MEDCHECK project root scripts",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "backend/venv/bin/uvicorn backend.main:app --reload --port 8000",
    "dev:all": "sh -c 'backend/venv/bin/uvicorn backend.main:app --reload --port 8000 & npm --prefix frontend run dev'",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:backend": "backend/venv/bin/pytest backend/tests/ -v"
  }
}
